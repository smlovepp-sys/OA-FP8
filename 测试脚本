import os
import sys
import time
import torch
import comfy
import comfy.sample
import comfy.model_management
import folder_paths

# 初始化 ComfyUI 运行环境与路径
current_dir = os.path.dirname(os.path.abspath(__file__))
custom_nodes_path = os.path.join(current_dir, "custom_nodes")
if custom_nodes_path not in sys.path:
    sys.path.insert(0, custom_nodes_path)

from OASingleFileLoader import OASingleFileLoader

def main():
    folder_paths.base_path = current_dir

    # 路径配置
    oa_package = r"D:\ComfyUI-aki-v3\ComfyUI\models\checkpoints\oa_package_v4_1.safetensors"
    skeleton = r"D:\sd-webui-forge\webui\models\Stable-diffusion\IllustriousXL\hassakuXLIllustrious_v34.safetensors"

    if not os.path.exists(oa_package):
        print(f"❌ OA 压缩包不存在: {oa_package}")
        return
    if not os.path.exists(skeleton):
        print(f"❌ 骨架模型不存在: {skeleton}")
        return

    print("\n============================================================")
    print("  OA 动态加载与流式推理 - 优化版性能基准压测")
    print("============================================================")

    # 1. 骨架模型 + OA 流式 Hook 挂载
    print(f"[1/4] 正在通过 Skeleton 骨架模型挂载 OA 流式包...")
    t0 = time.time()
    loader = OASingleFileLoader()
    model, clip, vae = loader.load_oa_single_file(ckpt_name=oa_package, skeleton_name=skeleton)
    device = comfy.model_management.get_torch_device()
    print(f" -> 模型加载与 Hook 绑定完毕，耗时: {time.time() - t0:.2f} s")

    # 2. 文本与条件 Latent 编码
    print(f"[2/4] 正在准备文本编码与 Latent 空间...")
    positive_prompt = "a close-up of a leaf with water droplets, highly detailed, 8k"
    negative_prompt = "blurry, low quality, distorted"

    def encode(clip_inst, text):
        try:
            c, p = clip_inst.encode(text)
            return c, p
        except ValueError:
            c = clip_inst.encode(text)
            p = torch.zeros(1, 1280, device=device)
            return c, p

    cond_pos, pooled_pos = encode(clip, positive_prompt)
    cond_neg, pooled_neg = encode(clip, negative_prompt)
    positive = [[cond_pos, {"pooled_output": pooled_pos}]]
    negative = [[cond_neg, {"pooled_output": pooled_neg}]]

    latent = torch.randn(1, 4, 128, 128, dtype=torch.float32, device=device)
    noise = latent.clone()

    steps = 20
    cfg = 7.5
    sampler_name = "euler"
    scheduler = "normal"
    denoise = 1.0

    # 3. 步速回调函数 (精确监控每一步的 s/it)
    step_times = []
    last_step_time = [time.time()]

    def callback(step, x0, x, total_steps):
        now = time.time()
        elapsed = now - last_step_time[0]
        step_times.append(elapsed)
        last_step_time[0] = now
        print(f"  Step {step + 1:02d}/{total_steps:02d} | 单步耗时: {elapsed:.3f} s ({1.0/elapsed:.2f} it/s)")

    print(f"[3/4] 构造完成，准备执行 {steps} Step 连续流式采样压测...")
    print(f"\n============================================================")
    print(f"  开始执行端到端采样推理...")
    print(f"============================================================")

    torch.cuda.synchronize()
    t_start_all = time.time()
    last_step_time[0] = time.time()

    try:
        samples = comfy.sample.sample(
            model,
            noise,
            steps,
            cfg,
            sampler_name,
            scheduler,
            positive,
            negative,
            latent,
            denoise=denoise,
            callback=callback
        )
        torch.cuda.synchronize()
        total_time = time.time() - t_start_all
        print(f"\n✅ 采样全部完成！纯采样耗时: {total_time:.3f} s")
    except Exception as e:
        print(f"❌ 采样失败: {e}")
        import traceback
        traceback.print_exc()
        return

    # 打印步速统计
    if len(step_times) > 1:
        warmup = step_times[0]
        stable = step_times[1:]
        avg_stable = sum(stable) / len(stable)
        print(f"  └─ 预热步耗时 (Step 1): {warmup:.3f} s")
        print(f"  └─ 稳定步平均耗时: {avg_stable:.3f} s/step ({1.0/avg_stable:.2f} it/s)")

    # 4. 显存优化与 VAE 全速解码
    print(f"\n[4/4] 清理 GPU 临时缓存，准备全速原生 VAE 解码...")
    try:
        # 清空采样阶段残留的缓存碎片，避免触发 Tiled VAE 降级
        comfy.model_management.soft_empty_cache()
        torch.cuda.empty_cache()

        t_vae_start = time.time()
        images = vae.decode(samples)
        torch.cuda.synchronize()
        print(f" -> 原生 VAE 解码完毕，耗时: {time.time() - t_vae_start:.3f} s")

        img = images[0].cpu().float().clamp(0, 1)
        if img.dim() == 4:
            img = img[0]
        if img.shape[-1] != 3:
            img = img.permute(1, 2, 0)

        from PIL import Image
        output_path = "oa_test_output.png"
        Image.fromarray((img.numpy() * 255).astype('uint8')).save(output_path)
        print(f"💾 图像已成功保存至: {output_path}")
    except Exception as e:
        print(f"❌ 图像解码保存失败: {e}")

    print(f"============================================================")
    print(f"  基准性能测试圆满结束！")
    print(f"============================================================\n")

if __name__ == "__main__":
    main()
